# Use Ollama locally or choose groq and provide a rotated key in this backend-only file.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_API_BASE=http://host.docker.internal:11434
GROQ_API_KEY=
# Optional private Zapier Webhooks by Zapier Catch Hook URL. Never put this in the frontend.
ZAPIER_WEBHOOK_URL=
WEB_PORT=8080
API_PORT=8000
