# Local development credentials only. Change every password and secret before exposing services.
POSTGRES_USER=enterpriseai
POSTGRES_PASSWORD=dev-only-postgres-change-me
POSTGRES_DB=enterpriseai
JWT_SECRET=dev-only-change-to-a-random-64-character-secret-string-now
ADMIN_EMAIL=admin@enterpriseai.local
ADMIN_PASSWORD=dev-only-admin-change-me
GRAFANA_USER=admin
GRAFANA_PASSWORD=dev-only-grafana-change-me

# Local-first model configuration. Pull these models into the Ollama container after startup.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# Optional: set LLM_PROVIDER=groq and provide a rotated key to use Groq instead.
GROQ_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
VISION_MODEL=llava:7b
WHISPER_MODEL=small
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_GRAPH=enterpriseai
REDIS_STREAM=enterpriseai:events
REDIS_DEAD_STREAM=enterpriseai:events:dead

# Configure this with the private URL from a Zapier Webhooks by Zapier Catch Hook.
ZAPIER_WEBHOOK_URL=
# Public DNS name used by docker-compose.prod.yml for HTTPS.
DOMAIN=agents.example.com
WEB_PORT=8080
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://avilash01.github.io

